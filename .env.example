# Contact form email delivery (Vercel serverless function: /api/contact)

# Copy this file to .env.local and fill in real values for local testing,
# then set the same variables in Vercel > Settings > Environment Variables.
# Never commit real credentials.

# SMTP_HOST   smtp.gmail.com
# SMTP_PORT   587

# Your Gmail address that receives the enquiries
SMTP_USER=nechecode@gmail.com

# A Gmail App Password (with 2-Step Verification enabled):
#   myaccount.google.com > Security > App passwords
# This is NOT your normal Gmail password.
SMTP_PASS=

# Optional: override the recipient (defaults to nechecode@gmail.com)
# CONTACT_RECIPIENT=nechecode@gmail.com